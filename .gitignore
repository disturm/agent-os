node_modules/
.env
.next/
next-env.d.ts
*.tsbuildinfo

# перезаписываются при каждом запуске
data/output.md
data/shopping.md

# дописываются шагом обновления памяти на каждый одобренный прогон (docs/specA.md):
# в репозитории им делать нечего — один `npm run eval` добавил бы в дневник по записи на кейс.
# Рядом лежат посевные `*.example.md`: при первом обращении markdownData копирует их на место,
# поэтому свежий клон работает, а git status от прогонов не пачкается.
data/log.md
data/preferences.md

# копии планов, которые агент пишет через filesystem MCP. Сам каталог нужен в репозитории:
# сервер получает его в allowed directories при запуске, поэтому держим .gitkeep
plans/*
!plans/.gitkeep

# трейсы прогонов: копятся локально, в репозитории лежит один образец формата.
# Именно `runs/*`, а не `runs/`: исключённый каталог git не разворачивает, и отрицание внутри него не сработает.
runs/*
!runs/run-example.json
