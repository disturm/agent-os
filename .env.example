# --- Model Gateway: OpenRouter (docs/specB.md) ---
# Шлюз OpenAI-совместимый, поэтому переменные нейтральные: меняются baseURL, ключ
# и идентификаторы моделей — кода это не касается.

LLM_API_KEY=sk-or-v1-...
LLM_BASE_URL=https://openrouter.ai/api/v1

# Необязательно. Уезжает в заголовок HTTP-Referer — OpenRouter просит его для атрибуции.
# LLM_APP_URL=http://localhost:3000

# Три модели вместо одной: коуч пишет текст, ревьюер выносит вердикт, роутер выбирает
# слово из девяти. Дефолты повторяют поведение до specB — коуч и ревьюер pro, роутер flash.
AGENT_MODEL=deepseek/deepseek-v4-pro
REVIEWER_MODEL=deepseek/deepseek-v4-pro
ROUTER_MODEL=deepseek/deepseek-v4-flash

# Рекомендованный производственный сплит: генерация подешевле, контроль построже.
# Включается заменой двух строк выше — но помните, что он сдвинет результаты evals.
# AGENT_MODEL=deepseek/deepseek-v4-flash
# REVIEWER_MODEL=anthropic/claude-sonnet-5

# Необязательно. Запасная модель коуча: OpenRouter сам уйдёт на неё, если первая недоступна.
# Это список приоритетов в одном запросе, а не второй вызов — ретраев в harness не прибавляется.
# AGENT_FALLBACK_MODEL=openai/gpt-5.4-mini

# --- Учебный вариант: прямой DeepSeek, без шлюза (как было до docs/specB.md) ---
# Раскомментируйте вместо блока выше — переменные те же, меняются только значения.
# Fallback и учёт стоимости при этом отключаются сами: они специфичны для OpenRouter.
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.deepseek.com
# AGENT_MODEL=deepseek-v4-pro
# REVIEWER_MODEL=deepseek-v4-pro
# ROUTER_MODEL=deepseek-v4-flash

# --- Langfuse: трейсы, промпты, оценки evals (docs/specB.md) ---
# Необязательный блок целиком. Убрали его — приложение работает полностью на локальных
# файлах: трейсы в runs/*.json, промпты из prompts/*.md. Ничего не падает и не замедляется.

# Пара ключей из Settings → API Keys проекта Langfuse. Нужны обе половины.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# Куда ходить. Имя переменной то же, что читает сам SDK Langfuse.
# По умолчанию cloud — https://cloud.langfuse.com, ставить ничего не нужно.
# У cloud два региона, и ключи привязаны к своему: для US возьмите
# https://us.cloud.langfuse.com. Регион и ключи берите из одного и того же окна —
# при несовпадении будет 401, а он проглатывается вместе с остальными сбоями Langfuse
# (см. quietly в src/langfuse/client.ts): в логе окажется «трейс не отправлен», в UI пусто,
# и на настоящую причину ничто не укажет.
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Self-host из docker-compose.yml — вот эта строка. 3001, а не 3000: 3000 занят next dev.
# LANGFUSE_BASE_URL=http://localhost:3001

# Необязательно. Label, по которому берётся боевая версия промпта. Меняется в UI Langfuse,
# а не здесь: в этом весь смысл — правка промпта перестаёт быть деплоем.
# LANGFUSE_PROMPT_LABEL=production

# --- RAG: база знаний в Supabase pgvector (docs/spec8.md) ---
# Обязательны: без них прогон падает сразу, до вызовов модели.

# Project URL и service role key со страницы Settings → API проекта Supabase.
# Ключ обходит RLS и в браузер попадать не должен — им ходят только сервер и скрипты.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Эмбеддинги считает отдельный провайдер: у DeepSeek такого эндпоинта нет.
# Подойдёт любой OpenAI-совместимый /embeddings. По умолчанию — OpenAI.
# Сменили модель — поменяйте и размерность vector(N) в docs/001_create_knowledge_chunks_table.sql.
EMBEDDING_API_KEY=sk-...
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# Необязательно. Internal integration token из https://www.notion.so/profile/integrations.
# Есть — Notion MCP поднимается сам и коуч может сохранить план страницей; нет — сервер
# просто не запускается, остальное работает как обычно.
# NOTION_TOKEN=ntn_...
